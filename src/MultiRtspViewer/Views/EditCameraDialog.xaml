<Window x:Class="MultiRtspViewer.Views.EditCameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiRtspViewer.ViewModels"
        Title="Edit RTSP Camera" 
        Height="580" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#22d3ee"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#22d3ee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExampleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="#22d3ee"/>
                                <Setter Property="BorderBrush" Value="#22d3ee"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#22d3ee"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#06b6d4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#22d3ee" BorderThickness="1" CornerRadius="8">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,5">
                    <Run Text="EDIT" Foreground="#22d3ee"/>
                    <Run Text="RTSP CAMERA"/>
                </TextBlock>
                <TextBlock Text="Update your RTSP stream configuration" 
                          Foreground="#64748b" 
                          FontSize="13"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Camera Name -->
                <TextBlock Text="CAMERA NAME" 
                          Foreground="#94a3b8" 
                          FontSize="12" 
                          FontWeight="Bold"
                          Margin="0,0,0,8"/>
                <TextBox Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource CyberTextBox}"
                        Margin="0,0,0,20"/>

                <!-- RTSP URL -->
                <TextBlock Text="RTSP URL" 
                          Foreground="#94a3b8" 
                          FontSize="12" 
                          FontWeight="Bold"
                          Margin="0,0,0,8"/>
                <TextBox Text="{Binding RtspUrl, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource CyberTextBox}"
                        Margin="0,0,0,10"/>

                <!-- Validation Message -->
                <TextBlock Text="{Binding ValidationMessage}" 
                          Foreground="{Binding IsValid, Converter={StaticResource BoolToColorConverter}}"
                          FontSize="12"
                          Margin="0,0,0,15"/>

                <!-- AI Toggle -->
                <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                     <StackPanel>
                        <!-- Enable AI -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ENABLE AI DETECTION" Foreground="#22d3ee" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="Detect people &amp; vehicles" Foreground="#64748b" FontSize="10"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsAiEnabled}" VerticalAlignment="Center" Margin="10,0,0,0">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>
                        
                        <!-- Detection Options -->
                        <StackPanel>
                            <Border Height="1" Background="#334155" Margin="0,0,0,10"/>
                            
                            <!-- Detect Person -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Detect Person" Foreground="#94a3b8" FontSize="10" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding DetectPerson}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Detect Vehicle -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Detect Vehicle" Foreground="#94a3b8" FontSize="10" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding DetectVehicle}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Examples -->
                <Border Background="#1e293b" 
                       BorderBrush="#334155" 
                       BorderThickness="1"
                       CornerRadius="6"
                       Padding="15"
                       Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="EXAMPLE FORMATS" 
                                  Foreground="#94a3b8" 
                                  FontSize="11" 
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>
                        
                        <WrapPanel>
                            <Button Content="Demo Stream" 
                                   Style="{StaticResource ExampleButton}"
                                   Command="{Binding UseExampleCommand}"
                                   CommandParameter="rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mov"
                                   Margin="0,0,5,5"/>
                            <Button Content="Local Camera" 
                                   Style="{StaticResource ExampleButton}"
                                   Command="{Binding UseExampleCommand}"
                                   CommandParameter="rtsp://192.168.1.100:554/stream"
                                   Margin="0,0,5,5"/>
                            <Button Content="With Auth" 
                                   Style="{StaticResource ExampleButton}"
                                   Command="{Binding UseExampleCommand}"
                                   CommandParameter="rtsp://admin:password@192.168.1.100:554/stream"
                                   Margin="0,0,0,5"/>
                        </WrapPanel>

                        <TextBlock Margin="0,10,0,0" 
                                  FontSize="11" 
                                  Foreground="#64748b"
                                  TextWrapping="Wrap">
                            <Run Text="Format:"/>
                            <Run Text="rtsp://[user:pass@]host[:port]/path" FontFamily="Consolas" Foreground="#22d3ee"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" 
                       Content="Cancel" 
                       Style="{StaticResource SecondaryButton}"
                       Click="CancelButton_Click"
                       Margin="0,0,10,0"/>
                
                <Button Grid.Column="2" 
                       Content="Save Changes" 
                       Style="{StaticResource PrimaryButton}"
                       Click="ConfirmButton_Click"
                       IsEnabled="{Binding IsValid}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
