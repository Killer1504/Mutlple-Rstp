<UserControl x:Class="MultiRtspViewer.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:local="clr-namespace:MultiRtspViewer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">

    <UserControl.Resources>
        <!-- CRT Scanline Effect (Simulated with Gradient) -->
        <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#10000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.5" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Background="#0f172a"> <!-- Slate-900 -->
        <Border BorderBrush="#22d3ee" BorderThickness="1" CornerRadius="4">
            <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" 
                                      Command="{Binding DataContext.OpenSpotlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
            <Grid>
                <!-- 1. VLC Video View (Base Layer) -->
                <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />

                <!-- 2. No Signal Placeholder (Visual Only) -->
                <Grid Visibility="{Binding Model.Status, Converter={StaticResource StatusToVisibilityConverter}}" 
                      Background="#0f172a" Panel.ZIndex="10" IsHitTestVisible="False">
                     <TextBlock Text="NO SIGNAL" Foreground="#22d3ee" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/>
                </Grid>

                <!-- 3. CRT Overlay (Visual Only) -->
                <Rectangle Fill="{StaticResource ScanlineBrush}" IsHitTestVisible="False" Opacity="0.3" Panel.ZIndex="15"/>

                <!-- 4. Info Overlay Bar (Visual Only) -->
                <Border VerticalAlignment="Bottom" Background="#CC0f172a" Height="30" Padding="10,0" Panel.ZIndex="20" IsHitTestVisible="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Model.Name}" Foreground="White" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Model.Status, Converter={StaticResource StatusToColorConverter}}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Model.Status}" Foreground="#94a3b8" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 6. AI Bounding Box Overlay -->
                <!-- Use Viewbox to scale the 640x640 YOLO coordinates to the actual video size -->
                <!-- 6. AI Bounding Box Overlay (Wrapped in Popup to fix Airspace/Z-Order issue over HWND VideoView) -->
                <!-- Note: Popups are separate top-level windows, so they can render over native controls -->
                <Popup IsOpen="True" Placement="Center" AllowsTransparency="True" IsHitTestVisible="False">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:CameraView}}" 
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=local:CameraView}}">
                        <Viewbox Stretch="Fill">
                            <ItemsControl ItemsSource="{Binding Detections}" Width="640" Height="640">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <Border BorderBrush="#ff0000" BorderThickness="3" CornerRadius="2">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                                                </Border.Effect>
                                            </Border>
                                            <Border Background="#ff0000" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="4,2" Margin="0,-20,0,0" CornerRadius="2">
                                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </Grid>
                </Popup>

                <!-- 5. Hit Test Overlay (Top Layer - Captures Double Click) -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
