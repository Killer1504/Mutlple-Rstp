<Window x:Class="MultiRtspViewer.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Settings" 
        Height="480" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a"
        Foreground="White"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#22d3ee"
        BorderThickness="1">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="SYSTEM PERFORMANCE" FontSize="20" FontWeight="Bold" Foreground="#22d3ee" Margin="0,0,0,20"/>

        <!-- Settings List -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Network Caching (ms)" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.NetworkCaching}" Margin="0,0,0,15" Background="#1e293b" Foreground="White" BorderBrush="#334155" Padding="5"/>

            <TextBlock Text="Grid Decoders (0=High, 1=Half, 2=Quarter, 3=Smallest)" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <Slider Value="{Binding Settings.AvcodecLowres}" Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding Settings.AvcodecLowres, StringFormat='Value: {0}'}" Foreground="#22d3ee" HorizontalAlignment="Right" Margin="0,0,0,15"/>

            <CheckBox IsChecked="{Binding Settings.DisableAudioInGrid}" Content="Disable Audio in Grid" Foreground="White" Margin="0,0,0,15"/>
            <CheckBox IsChecked="{Binding Settings.UseHardwareAcceleration}" Content="Hardware Acceleration (DXVA)" Foreground="White" Margin="0,0,0,15"/>
            
            <TextBlock Text="Clock Jitter Control" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.ClockJitter}" Background="#1e293b" Foreground="White" BorderBrush="#334155" Padding="5" Margin="0,0,0,15"/>

            <CheckBox IsChecked="{Binding Settings.LowMemoryMode}" Content="Low Memory Mode (Aggressive)" Foreground="#f43f5e" FontWeight="Bold" Margin="0,0,0,15"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Background="Transparent" Foreground="#94a3b8" Margin="0,0,10,0" BorderThickness="0" Padding="15,5"/>
            <Button Content="APPLY &amp; SAVE" Click="Save_Click" Background="#22d3ee" Foreground="#0f172a" FontWeight="Bold" Padding="20,8" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
