<Window x:Class="MultiRtspViewer.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiRtspViewer.ViewModels"
        Title="About" 
        Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.DataContext>
        <vm:AboutViewModel/>
    </Window.DataContext>

    <Border BorderBrush="#22d3ee" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Close Btn -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" Margin="10"
                    Content="✕" Foreground="#64748b" Background="Transparent" BorderThickness="0" 
                    FontSize="16" Click="CloseButton_Click" Cursor="Hand">
                <Button.Template>
                     <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                         <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Icon -->
                <Image Source="/Assets/icon.png" Width="80" Height="80" Margin="0,0,0,20">
                    <Image.Effect>
                        <DropShadowEffect Color="#22d3ee" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                    </Image.Effect>
                </Image>

                <!-- Initial -->
                <TextBlock Text="{Binding AppName}" 
                           Foreground="White" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,5">
                    <TextBlock.Effect>
                         <DropShadowEffect Color="#22d3ee" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" 
                           Foreground="#22d3ee" FontSize="14" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <TextBlock Text="{Binding Description}" 
                           Foreground="#94a3b8" FontSize="14" TextAlignment="Center" 
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="20,0,20,0"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#1e293b" Padding="15" CornerRadius="0,0,8,8" BorderBrush="#334155" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Copyright}" 
                           Foreground="#64748b" FontSize="12" 
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
